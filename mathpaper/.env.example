# Copy this file to .env in the project directory. Restart the servers after editing.
MATHPAPER_DATA=./data
MATHPAPER_LLM_PROVIDER=ollama
MATHPAPER_LLM_URL=http://127.0.0.1:11434
MATHPAPER_CHAT_MODEL=
# To use the native Gemini adapter, set provider=gemini,
# URL=https://generativelanguage.googleapis.com/v1beta,
# model=gemini-3.5-flash-lite, and add your key below.
# For a hosted OpenAI-compatible service, use provider=openai-compatible,
# its API base URL (usually ending /v1), and a model available in your account.
MATHPAPER_API_KEY=
MATHPAPER_MCP_URL=http://127.0.0.1:8001/mcp
MATHPAPER_MAX_TOOL_CALLS=6
MATHPAPER_MAX_REPAIRS=1
MATHPAPER_MAX_MODEL_CALLS=10
# Public chat also requires MATHPAPER_PUBLIC_CHAT=1 and a connected model.
# Shared limits apply to all visitors; SQLite state resets on a Render redeploy.
MATHPAPER_CHAT_DAILY_LIMIT=20
MATHPAPER_CHAT_COOLDOWN=20
MATHPAPER_ORT_THREADS=2
# Local baseline is FP32. Set precision=int8 and batch size=1 for lower memory.
MATHPAPER_MODEL_PRECISION=fp32
MATHPAPER_INFERENCE_BATCH_SIZE=16
MATHPAPER_DEFAULT_CANDIDATES=50
MATHPAPER_MAX_CANDIDATES=150
# Also enforced by the package before ONNX Runtime is imported.
ORT_DISABLE_TELEMETRY=1
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_TELEMETRY_MODE=off
